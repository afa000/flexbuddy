{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/small-context.md"],
  "compaction": { "auto": true, "keep": { "tokens": 8000 } },
  "watcher": {
    "ignore": ["flexbuddy/target/**", "android/build/**", "android/app/build/**", ".ai/artifacts/**", ".claude/worktrees/**"]
  },
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git show*", "effect": "allow" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean*", "effect": "deny" },
    { "action": "shell", "resource": "gh pr merge*", "effect": "deny" }
  ],
  "agents": {
    "headless": {
      "description": "Unattended runs from scripts/run-agent.ps1: edits files, runs only read-only git and node --test",
      "mode": "primary",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*db/migration/*", "effect": "deny" },
        { "action": "read", "resource": "*i18n/messages*.properties", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git show*", "effect": "allow" },
        { "action": "shell", "resource": "git branch*", "effect": "allow" },
        { "action": "shell", "resource": "node --test*", "effect": "allow" }
      ]
    }
  }
}
