{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard.mjs\" release",
            "timeout": 10,
            "statusMessage": "Checking for a release to main"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard.mjs\" migration",
            "timeout": 10,
            "statusMessage": "Checking for a committed migration"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard.mjs\" catalog",
            "timeout": 10,
            "statusMessage": "Checking for a whole message catalog read"
          }
        ]
      }
    ]
  }
}
