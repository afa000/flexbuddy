# Android signing material must never be committed.
*.keystore
*.jks
*.p12

# Android and Gradle build output.
android/.gradle/
android/.idea/
android/.cxx/
android/local.properties
android/app/build/
android/build/
android/*.apk
android/*.aab
android/*.idsig

# Root-level output produced if Bubblewrap is run from the wrong directory.
/.gradle/
/app/
/build/
/app-release-*.apk
/app-release-*.aab

# Local coding-agent working files: check logs, handoff reports and review packets. Task specifications in .ai/tasks/
# and design references in .ai/design/ are committed.
.ai/artifacts/
.ai/implementations/
.ai/reviews/

# Claude Code's own worktrees and personal settings. CLAUDE.md and .claude/launch.json are committed.
.claude/worktrees/
.claude/settings.local.json

# IntelliJ IDEA project settings.
.idea/
